# ══════════════════════════════════════════════════
# GENZ WhatsApp Frontend — copy to .env.local
# ══════════════════════════════════════════════════

# ── API & Socket ─────────────────────────────────
# Local development
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Production (single hostname)
# VITE_API_URL=https://genz-whatsapp-1.onrender.com/api
# VITE_SOCKET_URL=https://genz-whatsapp-1.onrender.com

# ── Auth ─────────────────────────────────────────
VITE_REQUIRE_AUTH=true
VITE_ENABLE_DEMO_DATA=false

# ── Push Notifications (VAPID) ────────────────────
# Generate with: node backend/scripts/generate-vapid.js
# Must match backend VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=

# ── WebRTC (TURN servers for production calls) ────
# Leave empty to use Google STUN + the free OpenRelay fallback (works for
# same-network calls; mobile-network calls may fail without a real TURN).
#
# Preferred: Metered.ca TURN (https://www.metered.ca/tools/openrelay/ or
# paid account). Free tier: create an account, copy username + password.
# When BOTH are set, the app uses the Metered relay first.
VITE_METERED_TURN_USERNAME=
VITE_METERED_TURN_PASSWORD=
#
# Alternative: any custom TURN server (used when Metered creds are empty)
VITE_TURN_SERVER_URL=
VITE_TURN_SERVER_URL_TCP=
VITE_TURN_SERVER_URL_TLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
