# ══════════════════════════════════════════════════
# Genz Messenger Frontend — copy to .env.development.local
# ══════════════════════════════════════════════════
#
# ⚠️  Put machine-local/dev overrides in `.env.development.local`, NOT
#     `.env.local`. Vite loads `.env.local` in EVERY mode — including
#     `vite build` — so a dev entry there (e.g. the Android emulator address
#     http://10.0.2.2:5000) silently gets baked into production web builds and
#     into the release APK. resolveApiBase() only falls back to the production
#     backend when VITE_API_URL is EMPTY, so the broken value wins and the APK
#     cannot reach the API on a real phone.
#
#     `npm run apk:build` and the Render deploy set VITE_API_URL explicitly,
#     which takes precedence; `npm run verify:bundle` proves what a finished
#     build actually baked.

# ── API & Socket ─────────────────────────────────
# Local development (unset/blank = same-origin /api through the Vite proxy)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Android emulator (the emulator reaches the host machine as 10.0.2.2)
# VITE_API_URL=http://10.0.2.2:5000
# VITE_SOCKET_URL=http://10.0.2.2:5000

# Production (single hostname)
# VITE_API_URL=https://genz-whatsapp-1.onrender.com/api
# VITE_SOCKET_URL=https://genz-whatsapp-1.onrender.com

# ── Auth ─────────────────────────────────────────
VITE_REQUIRE_AUTH=true
VITE_ENABLE_DEMO_DATA=false

# ── Push Notifications (VAPID) ────────────────────
# Generate with: node backend/scripts/generate-vapid.js
# Must match backend VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=
