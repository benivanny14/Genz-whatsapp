# ══════════════════════════════════════════════════
# GENZ WhatsApp Frontend — copy to .env.local
# ══════════════════════════════════════════════════

# ── API & Socket ─────────────────────────────────
# Local development
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Production (single hostname)
# VITE_API_URL=https://genz-whatsapp-1.onrender.com/api
# VITE_SOCKET_URL=https://genz-whatsapp-1.onrender.com

# ── Auth ─────────────────────────────────────────
VITE_REQUIRE_AUTH=true
VITE_ENABLE_DEMO_DATA=false

# ── Push Notifications (VAPID) ────────────────────
# Generate with: node backend/scripts/generate-vapid.js
# Must match backend VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=
