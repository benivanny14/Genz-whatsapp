    "bump:apk": "node scripts/bump-app-version.js",
    "test": "node --test \"src/tests/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "fcm:enable": "node scripts/enable-fcm.js"
  },
