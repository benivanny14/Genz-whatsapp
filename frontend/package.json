{
  "name": "tm-whatsapp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:single": "node scripts/start-single-origin.js",
    "dev:simple": "node scripts/cleanup-dev.js && vite",
    "dev:clean": "node scripts/cleanup-dev.js && vite --force",
    "build": "vite build",
    "start": "node scripts/serve-production.js",
    "preview": "vite preview",
    "preview:prod": "vite preview --host 0.0.0.0 --port 80",
