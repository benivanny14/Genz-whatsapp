{
  "name": "tm-whatsapp-backend",
  "version": "1.0.0",
  "description": "TM WhatsApp Backend - Real-time Chat Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node scripts/check-syntax.js",
    "check:exports": "node scripts/verify-route-exports.js",
    "test": "jest --runInBand --forceExit",
    "test:integration": "node scripts/integration-test.js",
    "coverage": "jest --runInBand --forceExit --coverage --collectCoverageFrom=\"controllers/**/*.js\" --coverageReporters=json text",
    "coverage:scan": "node scripts/coverage-scan.js",
    "prod": "NODE_ENV=production node server.js",
    "build": "echo 'Backend is ready for production - no build step required'",
    "loadtest:100": "artillery run loadtest/concurrency-100.yml",
    "loadtest:500": "artillery run loadtest/concurrency-500.yml"
  },
  "keywords": [
    "whatsapp",
    "chat",
    "real-time",
    "socket.io"
  ],
  "author": "TM",
  "license": "MIT",
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true,
      "downloadDir": "./node_modules/.cache/mongodb-memory-server",
      "preferGlobalPath": false
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@simplewebauthn/server": "^13.3.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.2",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "file-type": "^22.0.1",
    "firebase-admin": "^12.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "otpauth": "^9.2.3",
    "qrcode": "^1.5.3",
    "qrcode-reader": "^1.0.4",
    "qrcode-terminal": "^0.12.0",
    "redis": "^4.7.1",
    "sharp": "^0.35.3",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.6.0",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "artillery": "^2.0.33",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.4",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.3"
  }
}
