# ══════════════════════════════════════════════════
# GENZ WhatsApp Backend — copy to .env and fill in
# ══════════════════════════════════════════════════
#
# ⚡ FASTEST WAY: run `node scripts/setup-render-env.js --dry-run` first.
#    The script reads this file, auto-generates every missing secret (JWT,
#    VAPID, encryption) and saves them back here. You only need to fill in the
#    values marked ⭐ below.
#
# Never commit the real .env — it is gitignored.

# ── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development            # production on Render (script overrides it)
LOG_LEVEL=info
TRUST_PROXY=1
MAX_UPLOAD_BYTES=104857600      # 100 MB
JSON_BODY_LIMIT=2mb
FORM_BODY_LIMIT=2mb

# ── Database ⭐ (REQUIRED FOR PRODUCTION) ───────
# MongoDB Atlas Free Tier: https://www.mongodb.com/cloud/atlas/register
#   → Build a Database → Free → Create user → Network Access (0.0.0.0/0)
#   → Connect → Drivers → copy connection string → replace <password>
# Local dev: mongodb://localhost:27017/genz-whatsapp
MONGODB_URI=mongodb://localhost:27017/genz-whatsapp
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0

# ── Auth secrets (auto-generated by the setup script) ───────
# Manual alternative:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Run it 6 times and paste below. JWT_REFRESH_SECRET MUST differ from JWT_SECRET.
JWT_SECRET=CHANGE_ME_48_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_48_HEX
ADMIN_JWT_SECRET=CHANGE_ME_ANOTHER_48_HEX
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs ⭐ (REQUIRED FOR PRODUCTION) ───────────
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
# Production: set both to your Render URL, e.g.
#   FRONTEND_URL=https://genz-whatsapp-1.onrender.com
#   PUBLIC_API_URL=https://genz-whatsapp-1.onrender.com

# ── Security (auto-generated by the setup script) ───────
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_48_HEX
BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY
MESSAGE_ENCRYPTION_SECRET=CHANGE_ME_32_BYTE_SECRET
ALLOW_ANONYMOUS_DEVICE_AUTH=false
ALLOW_MOCK_PAYMENTS=false

# ── Admin panel ──────────────────────────────────
# Obscure base path for admin auth routes (keep it secret-ish).
ADMIN_BASE_PATH=/api/system-gateway-x9k
# Optional: comma-separated IPs allowed to open the admin panel. Empty = all.
ADMIN_IP_ALLOWLIST=

# ── Phone verification gate ──────────────────────
# true = OTP required on register/login; false = direct access.
PHONE_VERIFICATION_REQUIRED=true

# ── Passkeys (WebAuthn) ⭐ ───────────────────────
# Must be the exact domain users visit, WITHOUT https:// — e.g.
#   RP_ID=genz-whatsapp-1.onrender.com
RP_ID=

# ── Media — Cloudinary ⭐ (REQUIRED FOR PRODUCTION) ──
# Without these, media is stored on the local disk and LOST on redeploy.
# Free tier: https://cloudinary.com/users/register/free → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis ⭐ (recommended for scaling) ───────────
# Free tier: https://redis.com/try-free/ → Copy connection string
# Without it the socket layer is single-instance and presence resets on restart.
REDIS_URL=
# Redis Cloud example: redis://default:password@host:port
REDIS_PASSWORD=

# ── Push Notifications (Web Push VAPID) ──────────
# Auto-generated by the setup script. Manual:
#   node backend/scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@genz-whatsapp.com

# ── Firebase FCM (optional; VAPID is enough for web push) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=

# ── Email/SMTP ───────────────────────────────────
# NOTE: email is currently NOT wired into the code — OTPs are delivered via
# WhatsApp (below). These are reserved for a future email channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Payments (manual mobile-money verification) ⭐ ──
# Users paste their M-Pesa/Vodacom SMS and an admin approves it manually.
# Use YOUR real receiving number — do NOT ship the hardcoded default
# (ERASTOR GODFREY PAUL / 0639533428 in manualPaymentController.js).
MANUAL_PAYMENT_RECEIVER_NAME=
MANUAL_PAYMENT_RECEIVER_NUMBER=

# ── WhatsApp OTP delivery ⭐ ─────────────────────
# whatsaapp-web  = whatsapp-web.js consumer protocol — FREE but the linked
#                  number can be BANNED for bulk OTP traffic (dev/personal only)
# cloud-api      = official Meta WhatsApp Business Cloud API — recommended for
#                  production: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_OTP_ENABLED=false
WHATSAPP_OTP_PROVIDER=cloud-api
WHATSAPP_OTP_COUNTRY_CODE=255
WHATSAPP_OTP_TTL_MINUTES=5
WHATSAPP_OTP_SESSION_DIR=
WHATSAPP_OTP_MESSAGE_TEMPLATE=Your GENZ WhatsApp OTP is {otp}. It expires in {minutes} minutes. Do not share it with anyone.
# Cloud API credentials (required only when WHATSAPP_OTP_PROVIDER=cloud-api):
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0

# ── Monitoring (optional) ────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Media access (optional) ──────────────────────
# REQUIRE_MEDIA_SIGNATURE=false uses an automatic signed-URL fallback.
REQUIRE_MEDIA_SIGNATURE=false
MEDIA_ACCESS_SECRET=
MEDIA_URL_TTL_SECONDS=3600

# ── GIPHY (GIF search) ───────────────────────────
GIPHY_API_KEY=

# ── Automated backups (optional) ─────────────────
# Cron expression for the backup scheduler (defaults to hourly).
BACKUP_SCHEDULE=0 * * * *
# Optional S3 storage; without these, backups stay on local disk.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Webhooks (optional) ──────────────────────────
WEBHOOK_IP_WHITELIST=

# ── Push delivery tuning (optional) ──────────────
PUSH_MAX_RETRIES=3
