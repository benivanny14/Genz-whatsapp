# ══════════════════════════════════════════════════
# GENZ WhatsApp Backend — copy to .env and fill in
# ══════════════════════════════════════════════════

# ── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/genz-whatsapp
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/genz-whatsapp
# Connection pool sizing (cap prevents connection exhaustion)
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0

# ── Auth (generate strong random strings!) ───────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# ── Security ─────────────────────────────────────
ADMIN_BOOTSTRAP_TOKEN=change-me-admin-bootstrap-token-32chars-min
BACKUP_ENCRYPTION_KEY=change-me-backup-encryption-key-32chars
MESSAGE_ENCRYPTION_SECRET=change-me-message-encryption-secret-32
ALLOW_ANONYMOUS_DEVICE_AUTH=false
ALLOW_SOCKET_WITHOUT_AUTH=false
ALLOW_MOCK_PAYMENTS=true

# ── Automated backups (P4) ───────────────────────
# Cron expression controlling how often the scheduler checks for due backups
# (per-user interval decides who actually runs). Defaults to hourly.
BACKUP_SCHEDULE=0 * * * *
# Optional S3 storage for backups; without these, backups stay on local disk.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Monitoring (P5) ─────────────────────────────
# Sentry error tracking; empty means disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Media — Cloudinary (optional; uses local uploads/ if unset) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis (optional; enables scaling, caching, rate limit) ───────
REDIS_URL=
# Redis Cloud: redis://user:pass@host:port

# ── SMS OTP (Africa's Talking or Twilio) ─────────
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Push Notifications (Web Push VAPID) ──────────
# Generate: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Firebase FCM (optional alternative to VAPID) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Payments (manual SMS verification only) ───────
# Payments are reviewed manually by admins. No provider API keys are required.
MANUAL_PAYMENT_RECEIVER_NAME=Erastor Godfrey Paul
MANUAL_PAYMENT_RECEIVER_NUMBER=0639533428
# Plan: Premium — 30 days, TZS 10000 (see SUBSCRIPTION_PLANS in manualPaymentController.js)

# ── WebRTC TURN Server (for production video calls) ──
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
