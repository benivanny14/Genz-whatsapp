# ══════════════════════════════════════════════════
# GENZ WhatsApp Backend — copy to .env and fill in
# ══════════════════════════════════════════════════

# ── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (REQUIRED FOR PRODUCTION) ───────────
# For local development: mongodb://localhost:27017/genz-whatsapp
# For production (MongoDB Atlas Free Tier):
# 1. Go to https://www.mongodb.com/cloud/atlas/register
# 2. Create free account and cluster
# 3. Get connection string and replace password
MONGODB_URI=mongodb://localhost:27017/genz-whatsapp
# Atlas example: mongodb+srv://username:password@cluster0.mongodb.net/genz-whatsapp?retryWrites=true&w=majority

# ── Auth (REQUIRED - generate strong random strings!) ───────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_GENERATED_48_HEX_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_GENERATED_48_HEX_SECRET
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── URLs (REQUIRED FOR PRODUCTION) ─────────────────────────
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# ── Security (REQUIRED FOR PRODUCTION) ─────────────────────
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME_GENERATED_48_HEX_TOKEN
BACKUP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY
MESSAGE_ENCRYPTION_SECRET=CHANGE_ME_32_BYTE_SECRET
ALLOW_ANONYMOUS_DEVICE_AUTH=false
ALLOW_SOCKET_WITHOUT_AUTH=false
ALLOW_MOCK_PAYMENTS=false

# ── Automated backups (P4) ───────────────────────
# Cron expression controlling how often the scheduler checks for due backups
# (per-user interval decides who actually runs). Defaults to hourly.
BACKUP_SCHEDULE=0 * * * *
# Optional S3 storage for backups; without these, backups stay on local disk.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Monitoring (P5) ─────────────────────────────
# Sentry error tracking; empty means disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Media — Cloudinary (REQUIRED FOR PRODUCTION) ──
# For local development, uses local uploads/ folder
# For production (Cloudinary Free Tier):
# 1. Go to https://cloudinary.com/users/register/free
# 2. Create free account
# 3. Dashboard → API Keys → Copy credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Redis (optional; enables scaling, caching, rate limit) ───────
# For production (Redis Cloud Free Tier):
# 1. Go to https://redis.com/try-free/
# 2. Create free account and database
# 3. Copy connection string
REDIS_URL=
# Redis Cloud example: redis://user:pass@host:port

# ── Push Notifications (Web Push VAPID) ──────────
# Generate: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=BA7lSYl6kELEQqwj2KE-IdqnLVzewGzzM0SKg5KgiY7ujTOgvIqvsAAmCycZ4X2DiAne9wzv0DmFGIWq8Sx1qUA
VAPID_PRIVATE_KEY=_P99il8YpGBFdAdUB-_B1XhzjAafC0lJZk6yVRsxRA4
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ── Firebase FCM (optional alternative to VAPID) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Email/SMTP (REQUIRED FOR EMAIL VERIFICATION) ──
# For production (SendGrid Free Tier):
# 1. Go to https://sendgrid.com/free/
# 2. Create free account
# 3. Settings → API Keys → Create API Key
# 4. Use API Key as SMTP_PASS with user "apikey"
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
MAIL_FROM=no-reply@yourdomain.com

# ── Payments (manual SMS verification only) ───────
# Payments are reviewed manually by admins. No provider API keys are required.
MANUAL_PAYMENT_RECEIVER_NAME=Your Name Here
MANUAL_PAYMENT_RECEIVER_NUMBER=+255000000000
# Plan: Premium — 30 days, TZS 10000 (see SUBSCRIPTION_PLANS in manualPaymentController.js)

# ── WebRTC TURN Server (for production video calls) ──
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
